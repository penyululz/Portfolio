---
import SectionHeading from "./SectionHeading.astro";
import CredentialCard from "./CredentialCard.astro";
import { credentials } from "../data/credentials";
import { education } from "../data/education";
import { sortCredentialsByDateDesc } from "../lib/credentials";

const sorted = sortCredentialsByDateDesc(credentials);
---

<section id="credentials" class="section">
  <div class="mx-auto max-w-7xl px-6">
    <SectionHeading lead="CERTIFICATIONS" accent="& EDUCATION" class="mb-12 sm:mb-16" />

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-14">
      <div data-education data-reveal>
        <h3 class="eyebrow mb-6">Education</h3>
        <ul class="space-y-6">
          {
            education.map((item) => (
              <li class="flex items-start gap-4">
                <span
                  aria-hidden="true"
                  class:list={[
                    "mt-2 h-2.5 w-2.5 shrink-0 rounded-full",
                    item.current ? "bg-emerald-500 motion-safe:animate-pulse" : "bg-zinc-400 dark:bg-zinc-600",
                  ]}
                />
                <div class="min-w-0 break-words">
                  <p class="font-bold text-zinc-950 dark:text-white">{item.title}</p>
                  <p class="mt-1 text-sm text-zinc-700 dark:text-zinc-400">{item.institution}</p>
                  <p class="mt-1 font-mono text-xs tracking-wider text-zinc-600 uppercase dark:text-zinc-400">{item.status}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2" aria-label="Certificates and courses">
        {
          sorted.map((c) => (
            <li data-reveal>
              <CredentialCard credential={c} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
