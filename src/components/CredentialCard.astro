---
import { Image } from "astro:assets";
import { Award, ShieldCheck } from "@lucide/astro";
import type { Credential } from "../data/types";
import { formatCredentialDate } from "../lib/credentials";

interface Props {
  credential: Credential;
  compact?: boolean;
}

const { credential: c, compact = false } = Astro.props;
const dateLabel = formatCredentialDate(c);
const pad = (n: number) => String(n).padStart(2, "0");
const isoDate = c.date ? `${c.date.year}-${pad(c.date.month)}-${pad(c.date.day)}` : undefined;
const Icon = c.kind === "accreditation" ? ShieldCheck : Award;
const mediaSize = compact ? "h-12 w-12" : "h-20 w-20 sm:h-24 sm:w-24";
---

<article
  data-credential
  class:list={[
    "flex gap-4 border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900/60",
    compact ? "items-center rounded-2xl p-3 pr-5" : "h-full items-start rounded-[1.5rem] p-5 shadow-[0_14px_36px_rgba(24,24,27,0.06)] dark:shadow-none",
  ]}
>
  {
    c.badge ? (
      <Image src={c.badge.src} alt={c.badge.alt} width={compact ? 96 : 192} class:list={[mediaSize, "shrink-0 object-contain"]} />
    ) : (
      <span
        class:list={[mediaSize, "flex shrink-0 items-center justify-center rounded-2xl bg-emerald-500/10 text-emerald-700 dark:text-emerald-400"]}
      >
        <Icon class={compact ? "h-6 w-6" : "h-9 w-9"} aria-hidden="true" />
      </span>
    )
  }
  <div class="min-w-0">
    <h3 class:list={["font-bold tracking-tight text-zinc-950 dark:text-white", compact ? "text-sm sm:text-base" : "text-base sm:text-lg"]}>
      {c.title}
    </h3>
    {c.issuer && <p class="mt-1 text-sm text-zinc-700 dark:text-zinc-400">{c.issuer}</p>}
    {
      (dateLabel || c.note || c.credentialId) && (
        <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs tracking-wider text-zinc-600 uppercase dark:text-zinc-400">
          {dateLabel && <time datetime={isoDate}>{dateLabel}</time>}
          {c.note && <span>{c.note}</span>}
          {c.credentialId && <span>ID {c.credentialId}</span>}
        </p>
      )
    }
  </div>
</article>
