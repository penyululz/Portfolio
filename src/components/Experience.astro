---
import SectionHeading from "./SectionHeading.astro";
import { roles } from "../data/experience";
import { formatPeriod, sortRolesByStartDesc } from "../lib/period";

const ordered = sortRolesByStartDesc(roles);
---

<section id="experience" class="section">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading lead="WORK" accent="EXPERIENCE" class="mb-12 sm:mb-16" />

    <div class="relative" data-timeline>
      <div aria-hidden="true" class="absolute top-0 bottom-0 left-[14px] w-[2px] bg-zinc-200 lg:left-1/2 lg:-translate-x-1/2 dark:bg-zinc-800"></div>
      <div
        aria-hidden="true"
        data-timeline-fill
        class="absolute top-0 bottom-0 left-[14px] z-10 w-[2px] origin-top bg-emerald-500 lg:left-1/2 lg:-translate-x-1/2"
        style="transform: scaleY(1)"
      >
      </div>

      <ol class="space-y-12 sm:space-y-16 lg:space-y-24">
        {
          ordered.map((role, i) => {
            const even = i % 2 === 0;
            return (
              <li class:list={["relative flex flex-col items-start gap-6 lg:flex-row lg:gap-0", even && "lg:flex-row-reverse"]} data-reveal>
                <span
                  aria-hidden="true"
                  class="absolute left-[8px] mt-2 h-3.5 w-3.5 rounded-full border-2 border-emerald-500 bg-white shadow-[0_0_15px_rgba(16,185,129,0.35)] lg:left-1/2 lg:h-4 lg:w-4 lg:-translate-x-1/2 dark:bg-black dark:shadow-[0_0_15px_rgba(16,185,129,0.5)]"
                />
                <div class="hidden lg:block lg:w-1/2" />
                <div class:list={["w-full pl-10 sm:pl-12 lg:w-1/2 lg:pl-0", even ? "lg:pr-16 lg:text-right" : "lg:pl-16"]}>
                  <div class:list={["mb-4 flex flex-wrap items-center gap-2", even && "lg:justify-end"]}>
                    <span class="inline-block rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 font-mono text-xs font-bold tracking-widest text-emerald-800 uppercase dark:text-emerald-400">
                      {formatPeriod(role.period)}
                    </span>
                    {role.kind === "teaching" && (
                      <span class="inline-block rounded-full border border-zinc-300 px-3 py-1 font-mono text-xs tracking-widest text-zinc-700 uppercase dark:border-zinc-700 dark:text-zinc-300">
                        Teaching
                      </span>
                    )}
                  </div>
                  <h3 class="mb-2 text-xl font-bold tracking-tight text-zinc-950 sm:text-2xl lg:text-3xl dark:text-white">{role.title}</h3>
                  <p class="mb-4 text-base font-medium text-zinc-700 sm:mb-5 sm:text-lg dark:text-zinc-400">{role.org}</p>
                  <ul class:list={["space-y-2 text-base leading-relaxed text-zinc-700 dark:text-zinc-400", even && "lg:ml-auto"]}>
                    {role.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import "../scripts/timeline";
</script>
