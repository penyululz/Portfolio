---
import SectionHeading from "./SectionHeading.astro";
import { profile } from "../data/profile";
import { education } from "../data/education";

const highlight = "hardware repair and IT support";
const [before, after] = profile.about[0].split(highlight);
const msu = education.find((item) => item.id === "msu");
---

<section id="about" class="section z-10">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid items-start gap-10 md:gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
      <SectionHeading lead="ABOUT" accent="ME" size="xl" stacked class="lg:col-span-5" />

      <div class="space-y-6 lg:col-span-7 lg:space-y-8" data-reveal>
        <p class="text-xl leading-relaxed font-light text-zinc-900 sm:text-2xl md:text-3xl dark:text-white">
          {before}<strong class="font-bold text-emerald-700 dark:text-emerald-400">{highlight}</strong>{after}
        </p>
        <p class="text-base leading-relaxed text-zinc-700 sm:text-lg md:text-xl dark:text-zinc-400">
          {profile.about[1]}
        </p>

        <div class="mt-8 grid gap-6 border-t border-zinc-200 pt-6 sm:grid-cols-2 sm:gap-8 sm:pt-8 dark:border-zinc-800/60">
          {
            msu && (
              <div>
                <h3 class="eyebrow mb-4">Education Path</h3>
                <ul class="space-y-3 text-zinc-800 dark:text-zinc-300">
                  <li class="flex items-start gap-3">
                    <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" />
                    <span>
                      {msu.title}, {msu.institution}
                    </span>
                  </li>
                  <li class="flex items-start gap-3">
                    <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-zinc-400 dark:bg-zinc-600" />
                    <span>{msu.status}</span>
                  </li>
                </ul>
              </div>
            )
          }
          <div>
            <h3 class="eyebrow mb-4">Core Philosophy</h3>
            <p class="text-zinc-700 dark:text-zinc-400">{profile.philosophy}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
