---
// AssetFlow architecture, drawn narrow enough to read at 360 px. Colours follow the theme.
const box = "fill-white stroke-zinc-300 dark:fill-zinc-900 dark:stroke-zinc-700";
const accentBox = "fill-emerald-50 stroke-emerald-500 dark:fill-emerald-950/60 dark:stroke-emerald-500";
const title = "fill-zinc-950 text-[14px] font-bold dark:fill-white";
const note = "fill-zinc-600 text-[12px] dark:fill-zinc-400";
const line = "stroke-zinc-400 dark:stroke-zinc-500";
---

<figure class="my-8 max-w-xl">
  <svg viewBox="0 0 360 400" role="img" aria-labelledby="af-diagram-title af-diagram-desc" class="h-auto w-full">
    <title id="af-diagram-title">AssetFlow architecture</title>
    <desc id="af-diagram-desc">
      On one Windows computer, the Electron window starts the engine. The engine runs the Next.js application and its own
      PostgreSQL 17 database, both on 127.0.0.1 only. The application produces Excel and PDF reports; the engine makes
      backups with SHA-256 checksums.
    </desc>
    <defs>
      <marker id="af-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 8 4 0 8z" class="fill-zinc-400 dark:fill-zinc-500"></path>
      </marker>
    </defs>

    <rect x="4" y="4" width="352" height="292" rx="14" fill="none" stroke-dasharray="5 4" class={line}></rect>
    <text x="16" y="24" class={note}>One Windows computer · nothing on the network</text>

    <rect x="60" y="36" width="240" height="52" rx="10" class={box}></rect>
    <text x="180" y="58" text-anchor="middle" class={title}>AssetFlow window</text>
    <text x="180" y="76" text-anchor="middle" class={note}>Electron · local only</text>

    <line x1="180" y1="88" x2="180" y2="114" class={line} stroke-width="1.5" marker-end="url(#af-arrow)"></line>
    <text x="188" y="105" class={note}>starts · stops</text>

    <rect x="60" y="116" width="240" height="52" rx="10" class={accentBox}></rect>
    <text x="180" y="138" text-anchor="middle" class={title}>Engine</text>
    <text x="180" y="156" text-anchor="middle" class={note}>Node.js · set-up · backup</text>

    <line x1="130" y1="168" x2="95" y2="200" class={line} stroke-width="1.5" marker-end="url(#af-arrow)"></line>
    <line x1="230" y1="168" x2="265" y2="200" class={line} stroke-width="1.5" marker-end="url(#af-arrow)"></line>

    <rect x="16" y="202" width="158" height="78" rx="10" class={box}></rect>
    <text x="95" y="226" text-anchor="middle" class={title}>Application</text>
    <text x="95" y="244" text-anchor="middle" class={note}>Next.js · React</text>
    <text x="95" y="262" text-anchor="middle" class={note}>127.0.0.1 only</text>

    <rect x="186" y="202" width="158" height="78" rx="10" class={box}></rect>
    <text x="265" y="226" text-anchor="middle" class={title}>PostgreSQL 17</text>
    <text x="265" y="244" text-anchor="middle" class={note}>its own cluster</text>
    <text x="265" y="262" text-anchor="middle" class={note}>127.0.0.1 only</text>

    <line x1="174" y1="241" x2="184" y2="241" class={line} stroke-width="1.5" marker-end="url(#af-arrow)"></line>

    <line x1="95" y1="280" x2="95" y2="322" class={line} stroke-width="1.5" marker-end="url(#af-arrow)"></line>
    <line x1="300" y1="142" x2="350" y2="142" class={line} stroke-width="1.5"></line>
    <line x1="350" y1="142" x2="350" y2="296" class={line} stroke-width="1.5"></line>
    <line x1="350" y1="296" x2="275" y2="322" class={line} stroke-width="1.5" marker-end="url(#af-arrow)"></line>

    <rect x="16" y="324" width="158" height="60" rx="10" class={accentBox}></rect>
    <text x="95" y="349" text-anchor="middle" class={title}>Excel &amp; PDF</text>
    <text x="95" y="367" text-anchor="middle" class={note}>weekly &amp; period</text>

    <rect x="186" y="324" width="158" height="60" rx="10" class={accentBox}></rect>
    <text x="265" y="349" text-anchor="middle" class={title}>Backups</text>
    <text x="265" y="367" text-anchor="middle" class={note}>SHA-256 checksums</text>
  </svg>
  <figcaption class="mt-3 text-sm text-zinc-700 dark:text-zinc-400">
    The window starts a private engine; everything runs on one computer and talks only to itself.
  </figcaption>
</figure>
