---
import { Code, Presentation, Server, Wrench } from "@lucide/astro";
import Marquee from "./Marquee.astro";
import SectionHeading from "./SectionHeading.astro";
import { marqueeRows, skillCards } from "../data/skills";
import type { SkillIcon } from "../data/types";

const icons: Record<SkillIcon, typeof Code> = {
  presentation: Presentation,
  wrench: Wrench,
  server: Server,
  code: Code,
};
---

<section id="skills" class="section overflow-x-clip">
  <div class="mb-14 flex -rotate-2 flex-col gap-3 sm:mb-18 sm:scale-105 sm:gap-4 lg:mb-24">
    <Marquee items={marqueeRows[0]} seconds={35} />
    <Marquee items={marqueeRows[1]} seconds={45} reverse />
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6">
    <SectionHeading
      lead="CORE"
      accent="SKILLS"
      copy="Skills grouped around teaching, hands-on support, deployment work and software development."
      class="mb-10 sm:mb-14"
    />

    <div class="grid gap-4 md:grid-cols-2 lg:gap-6">
      {
        skillCards.map((skill, i) => {
          const Icon = icons[skill.icon];
          return (
            <div
              class="group rounded-[1.5rem] border border-zinc-200 bg-white p-5 shadow-[0_14px_36px_rgba(24,24,27,0.07)] transition-colors hover:bg-zinc-50 sm:rounded-3xl sm:p-8 dark:border-zinc-800 dark:bg-zinc-900/50 dark:shadow-none dark:hover:bg-zinc-800/50"
              data-reveal
              style={`transition-delay: ${i * 100}ms`}
            >
              <Icon
                class="mb-4 h-8 w-8 text-emerald-500 transition-transform group-hover:scale-110 sm:mb-6 sm:h-10 sm:w-10"
                aria-hidden="true"
              />
              <h3 class="mb-2 text-xl font-bold text-zinc-950 sm:mb-3 sm:text-2xl dark:text-white">{skill.title}</h3>
              <p class="text-base leading-relaxed text-zinc-700 sm:text-lg dark:text-zinc-400">{skill.summary}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
