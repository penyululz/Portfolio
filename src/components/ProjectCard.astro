---
import { Image } from "astro:assets";
import AiAssistedPill from "./AiAssistedPill.astro";
import type { Project } from "../data/types";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { media } = project;
---

<article
  class="flex h-full min-w-0 flex-col break-words overflow-hidden rounded-[1.5rem] border border-zinc-200 bg-white shadow-[0_14px_36px_rgba(24,24,27,0.07)] dark:border-zinc-800 dark:bg-zinc-900/60 dark:shadow-none"
  data-reveal
>
  {
    media.kind === "image" && (
      <div class="h-20 bg-white p-3 sm:h-24 lg:aspect-video lg:h-auto lg:p-4">
        <Image src={media.src} alt={media.alt} widths={[480, 800]} sizes="(min-width: 1024px) 24rem, (min-width: 640px) 50vw, 100vw" class="h-full w-full object-contain" />
      </div>
    )
  }
  <div class="flex min-w-0 flex-1 flex-col gap-3 border-t border-zinc-200 p-4 sm:p-5 lg:p-6 dark:border-zinc-800">
    <div class="flex flex-wrap gap-2">
      <span
        class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1.5 font-mono text-[10px] tracking-[0.22em] text-zinc-700 uppercase dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-300"
      >
        {project.type}
      </span>
      {project.aiAssisted && <AiAssistedPill />}
    </div>
    <h4 class="text-lg font-bold tracking-tight text-zinc-950 sm:text-xl lg:text-2xl dark:text-white">{project.title}</h4>
    <p class="text-sm leading-relaxed text-zinc-700 sm:text-base dark:text-zinc-400">{project.summary}</p>
    <ul class="mt-auto flex flex-wrap gap-2 pt-2" aria-label="Technologies">
      {
        project.tags.map((tag) => (
          <li class="rounded-full border border-zinc-200 bg-zinc-100 px-3 py-1 text-xs font-medium text-zinc-900 dark:border-white/10 dark:bg-white/10 dark:text-white">
            {tag}
          </li>
        ))
      }
    </ul>
  </div>
</article>
