---
import { Accessibility, Pause, RotateCcw, Type, Underline, ZoomIn, ZoomOut } from "@lucide/astro";

const action =
  "flex w-full items-center gap-3 rounded-2xl px-4 py-3 text-left text-sm text-zinc-800 transition-colors hover:bg-zinc-100 disabled:cursor-not-allowed disabled:opacity-45 dark:text-zinc-100 dark:hover:bg-zinc-800/70";
const iconClass = "h-4 w-4 shrink-0 text-emerald-700 dark:text-emerald-400";
const stateClass = "text-[10px] font-black tracking-[0.18em] text-zinc-600 uppercase dark:text-zinc-400";
---

<div class="fixed right-4 bottom-4 z-[90] flex flex-row-reverse items-end gap-3 sm:right-6 sm:bottom-6">
  <button
    type="button"
    data-a11y-toggle
    hidden
    aria-label="Open accessibility tools"
    aria-expanded="false"
    aria-controls="a11y-panel"
    class="flex h-14 w-14 items-center justify-center rounded-[1.25rem] border border-emerald-500/25 bg-zinc-950 text-white shadow-[0_20px_48px_-18px_rgba(16,185,129,0.45)] transition-transform hover:scale-[1.04] dark:bg-white dark:text-black"
  >
    <Accessibility class="h-6 w-6" aria-hidden="true" />
  </button>

  <div
    id="a11y-panel"
    hidden
    role="group"
    aria-label="Accessibility tools"
    class="fixed inset-x-4 bottom-20 max-h-[min(28rem,72vh)] overflow-y-auto rounded-[1.6rem] border border-zinc-200 bg-white p-4 shadow-[0_24px_60px_-28px_rgba(24,24,27,0.28)] sm:static sm:inset-auto sm:w-72 dark:border-zinc-800 dark:bg-zinc-950 dark:shadow-[0_28px_70px_-32px_rgba(0,0,0,0.7)]"
  >
    <div class="flex items-center justify-between gap-3 border-b border-zinc-200 px-1 pb-3 dark:border-zinc-800">
      <div>
        <p class="text-sm font-black tracking-tight text-zinc-950 dark:text-white">Accessibility</p>
        <p class="mt-1 text-[11px] font-medium tracking-[0.18em] text-zinc-600 uppercase dark:text-zinc-400">
          Text and readability tools
        </p>
      </div>
      <span
        data-a11y-scale
        class="rounded-full border border-emerald-500/25 bg-emerald-500/10 px-2.5 py-1 font-mono text-[10px] tracking-[0.22em] text-emerald-800 uppercase dark:text-emerald-400"
        >100%</span
      >
    </div>

    <div class="mt-3 space-y-1">
      <button type="button" data-a11y-increase class={action}>
        <ZoomIn class={iconClass} aria-hidden="true" /><span class="flex-1">Increase text</span>
      </button>
      <button type="button" data-a11y-decrease class={action}>
        <ZoomOut class={iconClass} aria-hidden="true" /><span class="flex-1">Decrease text</span>
      </button>
      <button type="button" data-a11y-underline aria-pressed="false" class={action}>
        <Underline class={iconClass} aria-hidden="true" /><span class="flex-1">Underline links</span>
        <span data-state class={stateClass}>Off</span>
      </button>
      <button type="button" data-a11y-readable aria-pressed="false" class={action}>
        <Type class={iconClass} aria-hidden="true" /><span class="flex-1">Readable font</span>
        <span data-state class={stateClass}>Off</span>
      </button>
      <button type="button" data-a11y-motion aria-pressed="false" class={action}>
        <Pause class={iconClass} aria-hidden="true" /><span class="flex-1">Pause animations</span>
        <span data-state class={stateClass}>Off</span>
      </button>
    </div>

    <div class="mt-3 border-t border-zinc-200 pt-3 dark:border-zinc-800">
      <button type="button" data-a11y-reset class={action}>
        <RotateCcw class={iconClass} aria-hidden="true" /><span class="flex-1">Reset settings</span>
      </button>
    </div>
  </div>

</div>

<script>
  import "../scripts/a11y-tools";
</script>
