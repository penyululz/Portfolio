---
import "../styles/global.css";
import { SITE } from "../site.config";
import { profile } from "../data/profile";
import { marqueeRows } from "../data/skills";

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = `${SITE.url}/og-image.png`;
const ogImageAlt = "Portfolio preview for Mohamad Faris Danial";

const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.fullName,
  alternateName: profile.shortName,
  jobTitle: "Lecturer & Technical Builder",
  worksFor: { "@type": "CollegeOrUniversity", name: "Tech Terrain College" },
  email: `mailto:${profile.email}`,
  url: SITE.url,
  sameAs: [profile.links.linkedin, profile.links.github, profile.links.website],
  knowsAbout: [...new Set(marqueeRows.flat())],
});
---

<!doctype html>
<html lang="en-MY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={SITE.themeColor.dark} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add("js");
        let t = null;
        try { t = localStorage.getItem("theme"); } catch {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        d.classList.toggle("dark", t === "dark");
        d.dataset.theme = t;
        d.style.colorScheme = t;
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", t === "dark" ? "#050505" : "#ffffff");
        // Saved accessibility settings, applied before paint (mirrors parseSettings in src/lib/a11y.ts).
        try {
          const a = JSON.parse(localStorage.getItem("portfolio-accessibility-settings") || "null");
          if (a && typeof a === "object") {
            if (typeof a.textScale === "number" && isFinite(a.textScale)) {
              const s = Math.round(Math.min(1.3, Math.max(0.9, a.textScale)) * 100) / 100;
              d.style.setProperty("--app-font-scale", String(s));
            }
            d.classList.toggle("a11y-links-underline", a.linksUnderline === true);
            d.classList.toggle("a11y-readable-font", a.readableFont === true);
            d.classList.toggle("a11y-no-motion", a.pauseMotion === true);
          }
        } catch {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.fullName} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-config" content="/browserconfig.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_MY" />
    <meta property="og:site_name" content="Mohamad Faris Danial Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={personJsonLd} />
    <slot name="head" />
  </head>
  <body
    class="bg-white text-zinc-950 antialiased selection:bg-emerald-500/20 overflow-x-clip dark:bg-[#050505] dark:text-zinc-50"
  >
    <slot />
  </body>
</html>
