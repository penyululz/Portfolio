---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBackground from "../../components/PageBackground.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import AccessibilityTools from "../../components/AccessibilityTools.astro";
import CaseStudyHeader from "../../components/case-studies/CaseStudyHeader.astro";
import CaseStudyScreens from "../../components/case-studies/CaseStudyScreens.astro";
import { diagrams } from "../../components/case-studies/diagrams";
import { projects } from "../../data/projects";
import { caseStudyHref } from "../../lib/case-studies";

export async function getStaticPaths() {
  const entries = await getCollection("case-studies");
  return entries.map((entry) => {
    if (!projects.some((p) => p.id === entry.id)) throw new Error(`case study "${entry.id}" has no project`);
    return { params: { slug: entry.id }, props: { entry } };
  });
}

interface Props {
  entry: CollectionEntry<"case-studies">;
}

const { entry } = Astro.props;
const { data } = entry;
const project = projects.find((p) => p.id === entry.id)!;
const { Content } = await render(entry);
const Diagram = diagrams[entry.id];
const others = (await getCollection("case-studies")).filter((e) => e.id !== entry.id);
---

<BaseLayout title={`${data.title} case study | Mohamad Faris Danial`} description={data.description}>
  <PageBackground />
  <Navbar />
  <main id="main" class="relative z-10 mx-auto max-w-6xl px-6 pt-32 pb-20 sm:pt-36">
    <CaseStudyHeader
      title={data.title}
      summary={data.summary}
      facts={data.facts}
      stack={data.stack}
      links={data.links}
      aiAssisted={project.aiAssisted}
    />

    <section aria-labelledby="in-short" class="mt-16 max-w-3xl">
      <h2 id="in-short" class="text-2xl font-bold tracking-tight text-zinc-950 sm:text-3xl dark:text-white">In short</h2>
      {data.inShort.map((p) => <p class="mt-4 text-lg leading-relaxed text-zinc-800 dark:text-zinc-300">{p}</p>)}
    </section>

    <CaseStudyScreens hero={data.hero} screens={data.screens} />

    <section aria-labelledby="deep-dive" class="mt-16">
      <h2 id="deep-dive" class="text-2xl font-bold tracking-tight text-zinc-950 sm:text-3xl dark:text-white">
        Technical deep dive
      </h2>
      {Diagram && <Diagram />}
      <div class="case-study-prose max-w-3xl">
        <Content />
      </div>
    </section>

    <nav aria-label="More case studies" class="mt-20 flex flex-wrap gap-3 border-t border-zinc-200 pt-8 dark:border-zinc-800">
      <a
        href="/#projects"
        class="rounded-full border border-zinc-300 px-5 py-3 text-sm font-semibold text-zinc-900 hover:border-emerald-600 dark:border-zinc-700 dark:text-white"
      >
        Back to projects
      </a>
      {
        others.map((other) => (
          <a
            href={caseStudyHref(other.id)}
            class="rounded-full bg-emerald-500 px-5 py-3 text-sm font-semibold text-black transition-transform hover:scale-[1.02]"
          >
            {other.data.title} case study
          </a>
        ))
      }
    </nav>
  </main>
  <Footer />
  <AccessibilityTools />
</BaseLayout>
