---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBackground from "../components/PageBackground.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Teaching from "../components/Teaching.astro";
import Projects from "../components/Projects.astro";
import Credentials from "../components/Credentials.astro";
import Skills from "../components/Skills.astro";
import Experience from "../components/Experience.astro";
---

<BaseLayout>
  <PageBackground />
  <Navbar />
  <main id="main" class="relative z-10">
    <Hero />
    <About />
    <Teaching />
    <Projects />
    <Skills />
    <Experience />
    <Credentials />
    <section id="contact" class="section">
      <div class="mx-auto max-w-7xl px-6"><SectionHeading lead="CONTACT" accent="ME" stacked /></div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  import "../scripts/reveal";
</script>
