---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBackground from "../components/PageBackground.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
---

<BaseLayout>
  <PageBackground />
  <Navbar />
  <main id="main" class="relative z-10">
    <Hero />
    <About />
    <section id="teaching" class="section">
      <div class="mx-auto max-w-7xl px-6"><SectionHeading lead="TEACHING" accent="& TRAINING" size="xl" stacked /></div>
    </section>
    <section id="projects" class="section">
      <div class="mx-auto max-w-7xl px-6"><SectionHeading lead="SELECTED" accent="PROJECTS" stacked /></div>
    </section>
    <section id="skills" class="section">
      <div class="mx-auto max-w-7xl px-6"><SectionHeading lead="CORE" accent="SKILLS" /></div>
    </section>
    <section id="experience" class="section">
      <div class="mx-auto max-w-7xl px-6"><SectionHeading lead="WORK" accent="EXPERIENCE" /></div>
    </section>
    <section id="credentials" class="section">
      <div class="mx-auto max-w-7xl px-6"><SectionHeading lead="CERTIFICATIONS" accent="& EDUCATION" /></div>
    </section>
    <section id="contact" class="section">
      <div class="mx-auto max-w-7xl px-6"><SectionHeading lead="CONTACT" accent="ME" stacked /></div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  import "../scripts/reveal";
</script>
